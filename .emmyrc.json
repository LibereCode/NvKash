{
    "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
    "completion": {
        "autoRequire": true,
        "autoRequireNamingConvention": "camel-case",
        "callSnippet": true,
        "postfix": "@"
    },
    "diagnostics": {
        "diagnosticInterval": 500,
        "disable": [
            "undefined-global"
        ],
        "globals": []
    },
    "doc": {
        "syntax": "md"
    },
    "runtime": {
        "version": "LuaJIT",
        "requirePattern": [
            "lua/?.lua",
            "lua/?/init.lua",
            "?/lua/?.lua",
            "?/lua/?/init.lua"
        ]
    },
    "workspace": {
        "checkThirdParty": false,
        "library": [
            "$VIMRUNTIME",
            "$HOME/.local/share/nvim/lazy"
        ],
        "ignoreGlobs": [
            "**/*_spec.lua",
            "**/tests/**",
            "**/test/**",
            "**/spec/**",
            "**/doc/**",
            "**/.github/**",
            "**/examples/**",
            "**/scripts/**"
        ]
    }
}
